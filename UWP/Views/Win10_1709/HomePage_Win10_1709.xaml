<page:HomePageBase
    x:Class="DriveRPC.Shared.UWP.Views.HomePage_Win10_1709"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DriveRPC.Shared.UWP.Views.Controls"
    xmlns:converters="using:DriveRPC.Shared.UWP.Converters"
    xmlns:page="using:DriveRPC.Shared.UWP.Views"
    Background="{ThemeResource AppBackgroundAcrylic}">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis_Inverted" Invert="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <Grid>
        <StackPanel Padding="32" VerticalAlignment="Top">
            <TextBlock
                Margin="0,0,0,4"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="DriveRPC" />

            <TextBlock
                x:Name="StatusTextBlock"
                Margin="0,0,0,24"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Status: Unknown" />
        </StackPanel>

        <Grid
            Margin="20,100,20,100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <controls:StatusCard
                x:Name="StatusCardControl"
                Background="{ThemeResource AppBackgroundAcrylic}"
                Visibility="{x:Bind CardViewModel.ActivityName, Mode=OneWay, Converter={StaticResource StringToVis}}" />
        </Grid>

        <CommandBar VerticalAlignment="Bottom" Background="{ThemeResource AppBackgroundAcrylic}">
            <AppBarButton
                Click="StartRpc_Click"
                Icon="Play"
                Label="Start RPC"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis_Inverted}}" />

            <AppBarButton
                Click="StopRpc_Click"
                Icon="Stop"
                Label="Stop RPC"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </CommandBar>
    </Grid>
</page:HomePageBase>
