<page:AppearancePageBase
    x:Class="DriveRPC.Shared.UWP.Views.AppearancePage_Win11"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DriveRPC.Shared.UWP.Views.Controls"
    xmlns:converters="using:DriveRPC.Shared.UWP.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DriveRPC.Shared.Models"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:page="using:DriveRPC.Shared.UWP.Views"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis_Inverted" Invert="True" />
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    Click="StartRpc_Click"
                    Icon="Play"
                    Label="Start RPC"
                    ToolTipService.ToolTip="Start RPC"
                    Visibility="{x:Bind StatusViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis_Inverted}}" />

                <AppBarButton
                    Click="StopRpc_Click"
                    Icon="Stop"
                    Label="Stop RPC"
                    ToolTipService.ToolTip="Stop RPC"
                    Visibility="{x:Bind StatusViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <CommandBar.Content>
                    <TextBlock
                        x:Name="StatusTextBlock"
                        Margin="40,12,0,0"
                        Text="Status: Unknown" />
                </CommandBar.Content>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" Margin="6,-10,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Pivot
                x:Name="PresetPivot"
                Holding="PresetPivot_Holding"
                ItemsSource="{x:Bind ViewModel.Presets}"
                RightTapped="PresetPivot_RightTapped"
                SelectionChanged="PresetPivot_SelectionChanged">
                <Pivot.HeaderTemplate>
                    <DataTemplate x:DataType="models:AppearancePreset">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                    </DataTemplate>
                </Pivot.HeaderTemplate>
                <Pivot.ItemTemplate>
                    <DataTemplate x:DataType="models:AppearancePreset">
                        <Grid />
                    </DataTemplate>
                </Pivot.ItemTemplate>
            </Pivot>

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="AddPreset_Click"
                Content="+"
                ToolTipService.ToolTip="Add New Preset" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="16" Spacing="8">
                <TextBox
                    x:Name="PresetNameBox"
                    Header="Preset name"
                    PlaceholderText="Enter a name for this preset..."
                    Text="{x:Bind ViewModel.EditingPreset.Name, Mode=TwoWay}"
                    TextChanged="PresetNameBox_TextChanged" />

                <muxc:Expander
                    HorizontalAlignment="Stretch"
                    Header="Vehicle Configuration"
                    IsExpanded="True">
                    <StackPanel Width="220" Spacing="12">
                        <TextBox Header="Car name" Text="{x:Bind ViewModel.EditingPreset.CarName, Mode=TwoWay}" />
                        <TextBox Header="Car image URL" Text="{x:Bind ViewModel.EditingPreset.CarImageUrl, Mode=TwoWay}" />
                        <TextBox Header="Car image text" Text="{x:Bind ViewModel.EditingPreset.CarImageText, Mode=TwoWay}" />
                    </StackPanel>
                </muxc:Expander>

                <muxc:Expander HorizontalAlignment="Stretch" Header="Seating">
                    <StackPanel Spacing="12">
                        <ToggleSwitch Header="Show party info" IsOn="{x:Bind ViewModel.EditingPreset.ShowParty, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <muxc:NumberBox
                                Width="101"
                                Header="Total seats"
                                IsEnabled="{x:Bind ViewModel.EditingPreset.ShowParty, Mode=OneWay}"
                                LargeChange="2"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Text="{x:Bind ViewModel.EditingPreset.SeatCount, Mode=TwoWay}"
                                Value="1" />
                            <muxc:NumberBox
                                Width="101"
                                Header="Seats used"
                                IsEnabled="{x:Bind ViewModel.EditingPreset.ShowParty, Mode=OneWay}"
                                LargeChange="2"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Text="{x:Bind ViewModel.EditingPreset.SeatsUsed, Mode=TwoWay}"
                                Value="1" />
                        </StackPanel>
                    </StackPanel>
                </muxc:Expander>

                <muxc:Expander HorizontalAlignment="Stretch" Header="Telemetry Detail">
                    <StackPanel Spacing="12">
                        <ComboBox
                            x:Name="SpeedModeCombo"
                            HorizontalAlignment="Stretch"
                            Header="Speed detail"
                            ItemsSource="{x:Bind ViewModel.SpeedModes}" />
                        <ComboBox
                            x:Name="LocationModeCombo"
                            HorizontalAlignment="Stretch"
                            Header="Location detail"
                            ItemsSource="{x:Bind ViewModel.LocationModes}" />
                        <ToggleSwitch Header="Show compass" IsOn="{x:Bind ViewModel.EditingPreset.ShowCompass, Mode=TwoWay}" />

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                Text="Location data © OpenStreetMap contributors"
                                TextWrapping="Wrap" />
                            <HyperlinkButton
                                Padding="0"
                                Content="nominatim.openstreetmap.org"
                                FontSize="11"
                                NavigateUri="https://nominatim.openstreetmap.org" />
                        </StackPanel>
                    </StackPanel>
                </muxc:Expander>

            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="Row2Grid"
            Grid.Row="3"
            Padding="16"
            BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
            BorderThickness="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ControlsPanel"
                Grid.Row="0"
                Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="GpsSourceCombo"
                    Grid.Row="0"
                    Width="220"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Header="GPS source" />

                <StackPanel
                    x:Name="ReplayControlsPanel"
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="PauseButton"
                        Margin="0,0,8,0"
                        Click="PauseReplay_Click"
                        Visibility="{x:Bind ViewModel.IsReplaying, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE769;" />
                    </Button>

                    <Button
                        x:Name="ResumeButton"
                        Margin="0,0,8,0"
                        Click="ResumeReplay_Click"
                        Visibility="{x:Bind ViewModel.IsReplaying, Mode=OneWay, Converter={StaticResource BoolToVis_Inverted}}">
                        <FontIcon Glyph="&#xE768;" />
                    </Button>

                    <Slider
                        x:Name="ReplaySlider"
                        Width="140"
                        Margin="0,0,8,0"
                        Maximum="{x:Bind ViewModel.ReplayDuration.TotalSeconds, Mode=OneWay}"
                        Minimum="0"
                        ValueChanged="ReplaySlider_ValueChanged"
                        Value="{x:Bind ViewModel.ReplayPosition.TotalSeconds, Mode=OneWay}" />

                    <TextBlock
                        Margin="8,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="{x:Bind ViewModel.ReplayTimeText, Mode=OneWay}" />

                    <ComboBox
                        x:Name="ReplaySpeedCombo"
                        Width="80"
                        ItemsSource="{x:Bind ViewModel.ReplaySpeeds}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">

                    <Button
                        x:Name="ApplyButton"
                        Width="120"
                        Margin="0,0,8,0"
                        Click="Apply_Click"
                        Content="Apply" />
                    <Button
                        x:Name="SaveButton"
                        Width="120"
                        Click="Save_Click"
                        Content="Save" />
                </StackPanel>
            </Grid>

            <controls:StatusCard
                x:Name="PreviewStatusCard"
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DataContext="{x:Null}" />
        </Grid>
    </Grid>
</page:AppearancePageBase>
