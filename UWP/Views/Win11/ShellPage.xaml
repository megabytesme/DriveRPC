<Page
    x:Class="UWP.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DriveRPC.Shared.UWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    mc:Ignorable="d">

    <Grid>
        <muxc:NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem
                    Content="Home"
                    Icon="Home"
                    Tag="Home" />
                <muxc:NavigationViewItem
                    Content="Appearance"
                    Icon="Edit"
                    Tag="Appearance" />
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="AccountItem" Tag="Account">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid Width="24" Height="24">
                            <muxc:PersonPicture
                                x:Name="AccountPersonPicture"
                                Width="24"
                                Height="24" />
                            <muxc:ProgressRing
                                x:Name="AccountLoadingRing"
                                Width="16"
                                Height="16"
                                IsActive="False" />
                        </Grid>
                        <TextBlock
                            x:Name="AccountNameText"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="Account" />
                    </StackPanel>

                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="AccountFlyout">
                            <controls:DiscordAccountControl
                                x:Name="HeaderAccountControl"
                                LoadingStateChanged="HeaderAccountControl_LoadingStateChanged"
                                UserChanged="HeaderAccountControl_UserChanged" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" />
        </muxc:NavigationView>
    </Grid>
</Page>