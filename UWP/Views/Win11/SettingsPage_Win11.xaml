<page:SettingsPageBase
    x:Class="DriveRPC.Shared.UWP.Views.SettingsPage_Win11"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DriveRPC.Shared.UWP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:page="using:DriveRPC.Shared.UWP.Views"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel
            MaxWidth="800"
            HorizontalAlignment="Center"
            Spacing="8">

            <TextBlock
                x:Name="TitleBlock"
                Margin="0,0,0,16"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Settings" />

            <muxc:Expander HorizontalAlignment="Stretch" IsExpanded="True">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE77B;" />
                        <TextBlock VerticalAlignment="Center" Text="Discord Account" />
                    </StackPanel>
                </muxc:Expander.Header>
                <controls:DiscordAccountControl x:Name="AccountControl" />
            </muxc:Expander>

            <muxc:Expander HorizontalAlignment="Stretch">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE790;" />
                        <TextBlock VerticalAlignment="Center" Text="Appearance" />
                    </StackPanel>
                </muxc:Expander.Header>
                <StackPanel x:Name="AppearanceStackPanel" Spacing="12">
                    <RadioButton
                        Checked="AppearanceRadio_Checked"
                        Content="Windows 10 (1507)"
                        GroupName="AppearanceGroup"
                        Tag="1507" />
                    <RadioButton
                        Checked="AppearanceRadio_Checked"
                        Content="Windows 10 (1709)"
                        GroupName="AppearanceGroup"
                        IsChecked="True"
                        Tag="1709" />
                    <RadioButton
                        Checked="AppearanceRadio_Checked"
                        Content="Windows 11"
                        GroupName="AppearanceGroup"
                        Tag="11" />
                </StackPanel>
            </muxc:Expander>

            <muxc:Expander HorizontalAlignment="Stretch">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="Red"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="Red"
                            Text="Advanced" />
                    </StackPanel>
                </muxc:Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="The following actions are irreversible. Use with caution." />
                    <Button
                        x:Name="BtnResetAllSettings"
                        HorizontalAlignment="Stretch"
                        Background="DarkRed"
                        Click="BtnResetAllSettings_Click"
                        Content="Reset All App Data"
                        Foreground="White"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </muxc:Expander>

            <muxc:Expander HorizontalAlignment="Stretch">
                <muxc:Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" />
                        <TextBlock VerticalAlignment="Center" Text="Information" />
                    </StackPanel>
                </muxc:Expander.Header>
                <StackPanel Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="AboutButton_Click"
                        Content="About DriveRPC" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="DisclaimerButton_Click"
                        Content="Disclaimer &amp; Legal" />
                </StackPanel>
            </muxc:Expander>
        </StackPanel>
    </ScrollViewer>
</page:SettingsPageBase>