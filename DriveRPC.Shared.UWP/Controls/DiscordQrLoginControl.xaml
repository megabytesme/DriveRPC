<UserControl
    x:Class="DriveRPC.Shared.UWP.Controls.DiscordQrLoginControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="350" Height="450">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Login with QR Code" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Open the Discord mobile app and scan the code below." 
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" FontSize="14" Margin="0,0,0,10"/>

            <Grid Width="220" Height="220" Background="White" CornerRadius="8" Margin="0,0,0,10">
                <Border BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="8">
                    <Image x:Name="QrImage" Margin="10" Stretch="Uniform"/>
                </Border>
                <ProgressRing x:Name="QrProgress" IsActive="True" Foreground="Black" Width="40" Height="40"/>
            </Grid>

            <TextBlock x:Name="StatusLabel" Text="Connecting to Discord..." 
                       HorizontalAlignment="Center" FontSize="14"
                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>